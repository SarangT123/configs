### Status Bar
bar {
    swaybar_command waybar
}


###For removing titlebars 
#########################################
# keep a visible border (3px)
default_border pixel 3

# remove the title text for basically all windows
for_window [title="^.*"] title_format ""

# make the titlebar as small as possible
titlebar_padding 1
titlebar_border_thickness 0

# small font for titlebar (1px) — makes the titlebar height minimal
# NOTE: font size 0 used to be a hack but recent sway may reject 0; 1 is safe.
font pango:monospace 1
#########################################

###open the following apps for waybar scripts
# Make specific apps float and appear at cursor position
# for_window [app_id="nmtui"] floating enable, move position cursor, move position cursor, resize set 800 600
# Make specific apps float and appear at cursor position

# With offset (move right 10px, down 10px after cursor positioning)
for_window [app_id="kitty"] floating enable, move position cursor,move down 30px, resize set 500 500
for_window [app_id="pavucontrol"] floating enable, move position 1419 0, move down 50px, resize set 500 500
for_window [app_id="blueman-manager"] floating enable, move position cursor, move down 30px, resize set 500 500

### Autotiling
exec autotiling

### Gestures 
exec libinput-gestures-setup start

include /etc/sway/config.d/*

